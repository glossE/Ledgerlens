spring.application.name=ledgerlens

# --- PostgreSQL (matches docker-compose.yml) ---
spring.datasource.url=jdbc:postgresql://localhost:5432/ledgerlens
spring.datasource.username=ledger_user
spring.datasource.password=ledger_pass

# --- JPA / Hibernate ---
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

# --- Server (Cloud Run injects PORT; defaults to 8080 locally) ---
server.port=${PORT:8080}

# --- Google Gemini API key ---
# Get a free key from https://aistudio.google.com/app/apikey
# NOTE: if this key is missing/invalid, the app still works and falls back to
# keyword-based categorization (see GeminiService.keywordFallback).
gemini.api.key=YOUR_GEMINI_API_KEY_HERE
